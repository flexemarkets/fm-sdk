<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.flexemarkets</groupId>
        <artifactId>fm-sdk-parent</artifactId>
        <version>0.4.0</version><!-- fm-version -->
    </parent>

    <artifactId>fm-sdk</artifactId>
    <packaging>jar</packaging>

    <name>Flexemarkets SDK</name>
    <description>
        *** ALPHA SOFTWARE -- THE API IS NOT STABLE ***

        Pre-1.0 and under active development. Anything public may be added,
        renamed or removed in any release, breaking code that compiles today,
        with no deprecation period first. A 0.x version carries no
        compatibility promise and these are used that way: treat every bump
        as potentially breaking. Pin an exact version. Not recommended for
        production use.

        Java SDK for the Flexemarkets trading API.
    </description>
    <url>https://github.com/flexemarkets/fm-sdk</url>

    <properties>
        <!-- Override the parent's skip default: this module IS published. -->
        <maven.deploy.skip>false</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.7</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- sdk-version.properties is filtered so the User-Agent carries the
             version actually built; nothing else is, so ${...} in the view
             JSON under fm/views stays literal. -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>fm/internal/sdk-version.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>fm/internal/sdk-version.properties</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <!-- Self-contained published POM (no <parent>); see parent pluginManagement. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
            <!-- Critical code: the client, the desk and the event stream: what
                 places and cancels orders, signs in, and keeps a desk's books
                 current. The floor is today's coverage, so it can only go up.
                 Six lines are uncovered and none can be reached honestly:
                 two catch blocks the compiler requires (Events' background
                 reconnect thread being interrupted, HttpFlexemarkets.sdkVersion
                 failing to read a bundled resource) and _patch's serialisation
                 guard, whose only caller sends a map of strings. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>critical-coverage</id>
                        <phase>test</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>fm/*.class</include>
                                <include>fm/internal/*.class</include>
                            </includes>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.9955</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
