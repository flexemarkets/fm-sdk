<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.flexemarkets</groupId>
        <artifactId>fm-sdk-parent</artifactId>
        <version>0.2.0</version><!-- fm-version -->
    </parent>

    <artifactId>fm-spi</artifactId>

    <!--
        Its own version line, deliberately not the SDK's.

        This artifact is a contract: two interfaces and a version constant. It
        should change rarely, and when it does the change matters to every host
        and every provider. The SDK beside it is a client that changes often,
        and while the two moved together every SDK release minted an fm-spi
        release containing no change — which consumers then saw as a dependency
        update to review, and Dependabot filed a pull request for.

        0.0.9 carries a real fix: ParameterSpec.required was a primitive, and
        the shipped manifests write `"required": null`, so every one of them
        failed to parse and both hosts ran with an empty catalogue. 0.0.8 is
        published and immutable, hence the bump rather than a correction.

        Bump the patch for an additive change, and the major only alongside
        ServiceProvider.SPI_VERSION, since hosts reject a provider whose major
        differs from their own.

        Set with `make set-spi-version V=x.y.z`. `make set-version` moves the
        parent reference below but leaves this alone.
    -->
    <version>0.0.11</version><!-- spi-version -->

    <packaging>jar</packaging>

    <dependencies>
        <!--
            Annotations only, not databind. The manifest is JSON on the wire and
            a couple of its fields cannot be mapped by name alone (`default` is
            a Java keyword), so the mapping has to be declared somewhere. This
            is metadata on the classes, not a parser: what reads the JSON is the
            host's own Jackson, whichever major version it runs.

            It is the single dependency this artifact has, and worth keeping
            that way.
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.7</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <name>Flexemarkets SPI</name>
    <description>
        The plugin contract between Flex-E-Markets service implementations
        (e.g. trading robots) and their hosts. A host discovers a ServiceProvider
        via ServiceLoader and runs the Service it creates, without compiling
        against the implementation.

        Carries three things: the ServiceProvider/Service interfaces, the
        manifest a service uses to describe itself, and CliBuilder, which turns
        described parameters into the argument array the provider is created
        with. The manifest and the builder are here because both sides must
        agree on them exactly: a host that derived arguments its own way would
        be a second implementation of the contract, differing from the first
        only where it was wrong.

        No host internals and no implementation of any service. Published
        publicly so providers and hosts share one contract without copying
        source; the implementations stay private and are delivered to hosts as
        runtime plugin jars.
    </description>
    <url>https://github.com/flexemarkets/fm-sdk</url>

    <properties>
        <!-- Override the parent's skip default: this module IS published. -->
        <maven.deploy.skip>false</maven.deploy.skip>
    </properties>

    <!-- Interfaces only: no dependencies. -->

    <build>
        <plugins>
            <!-- Self-contained published POM (no <parent>); see parent pluginManagement. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Javadoc warnings fail this module, and only this module.

            This artifact is a contract between fm-server, fm-robots-server and
            every robot: its Javadoc is the specification an implementor reads,
            so an undocumented parameter here is a gap in the contract rather
            than a tidiness matter. Small enough to hold to that, too - eight
            files.

            Inside the release profile because that is where the parent gives
            the plugin its version and binds it. Declaring it in <build> instead
            leaves an unversioned plugin in every ordinary `mvn install`, which
            fails to resolve.

            Not set on the parent: fm-sdk has ~100 of these and does not pass.
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <configuration>
                            <failOnWarnings>true</failOnWarnings>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
