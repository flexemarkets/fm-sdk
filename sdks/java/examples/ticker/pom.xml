<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.flexemarkets</groupId>
        <artifactId>fm-sdk-parent</artifactId>
        <version>0.2.0-SNAPSHOT</version><!-- fm-version -->
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>fm-ticker</artifactId>
    <packaging>jar</packaging>

    <name>Flexemarkets Ticker Example</name>
    <description>Example ticker application using the Flexemarkets SDK</description>

    <dependencies>
        <dependency>
            <groupId>com.flexemarkets</groupId>
            <artifactId>fm-sdk</artifactId>
        </dependency>
        <dependency>
            <groupId>com.googlecode.lanterna</groupId>
            <artifactId>lanterna</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>fm.ticker.Ticker</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>fm.ticker.Ticker</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <!-- Every dependency brings its own module
                                             descriptor, and an uber jar has one
                                             classpath and no module graph: shade
                                             warns that flattening them breaks
                                             strong encapsulation, and it is right.
                                             This jar is run with -jar, not as a
                                             module, so the descriptors describe
                                             nothing and are dropped. -->
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                        <!-- A signature covers the jar it was made
                                             for. Repackaged into a different jar it
                                             cannot verify, and a JVM that checks
                                             will refuse to load the classes. -->
                                        <!-- Shade counts the manifest as an
                                             overlapping resource even though the
                                             transformer below claims it, so the
                                             warning survives handling it. Dropping
                                             the dependencies' copies removes the
                                             overlap; the transformer still writes
                                             ours, Main-Class included. -->
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <!-- Six jars carry a MANIFEST.MF and shade keeps
                                     whichever it meets first, so Main-Class was a
                                     matter of dependency order. State it. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>fm.ticker.Ticker</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <!-- LICENSE and NOTICE are the one case where
                                     "keep one, drop the rest" is not merely untidy:
                                     the Apache licence requires the NOTICE content
                                     to travel with the redistribution. These merge
                                     rather than pick. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Matches the parent's release profile, so the plugin declared there
             supplies the version and this only adds the skip. Declaring it
             outside a profile leaves the version unresolvable on an ordinary
             build. -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <!--
                        The example is not published, and must not try.

                        excludeArtifacts in the parent keeps it out of the bundle, and
                        that worked: fm-ticker is still at 0.0.3 on Central. But
                        extensions=true activates this plugin for every module in the
                        reactor, so it still ran here, opened its own deployment, and
                        failed, after fm-sdk 0.1.0 had already been published. The
                        release was complete and the build exited 1.

                        That is the failure mode the parent's own comment warns about
                        for fm-spi 0.0.10: the obvious response to a red release is to
                        run it again, and every registry here is append-only, so the
                        second run cannot work and reports the version as already
                        taken.

                        skipPublishing does NOT make this module inert, and what
                        stood here said it did. This module is last in the reactor,
                        and the plugin stages every module into one directory and
                        uploads the bundle once, from the last one. So this execution
                        carries fm-sdk's whole deployment and then blocks on the
                        parent's waitUntil=PUBLISHED. When 0.1.3 sat in the portal's
                        queue past the plugin's 30 minute default, the release was
                        complete and the build exited 1, for a module that shipped
                        nothing.

                        So the fix is neither here nor in the reactor's membership:
                        dropping this module makes fm-sdk last and moves the same
                        wait onto it. It is waitMaxTime in the parent, and the
                        workflow asking Central before it believes a red build.

                        skipPublishing stays because it costs nothing and keeps this
                        module's coordinates out of a deployment if the parent's
                        excludeArtifacts is ever edited.
                    -->
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <configuration>
                            <skipPublishing>true</skipPublishing>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
