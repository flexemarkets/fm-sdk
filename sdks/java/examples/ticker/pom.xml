<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.flexemarkets</groupId>
        <artifactId>fm-sdk-parent</artifactId>
        <version>0.1.0</version><!-- fm-version -->
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>fm-ticker</artifactId>
    <packaging>jar</packaging>

    <name>Flexemarkets Ticker Example</name>
    <description>Example ticker application using the Flexemarkets SDK</description>

    <dependencies>
        <dependency>
            <groupId>com.flexemarkets</groupId>
            <artifactId>fm-sdk</artifactId>
        </dependency>
        <dependency>
            <groupId>com.googlecode.lanterna</groupId>
            <artifactId>lanterna</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>fm.ticker.Ticker</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>fm.ticker.Ticker</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <!-- Every dependency brings its own module
                                             descriptor, and an uber jar has one
                                             classpath and no module graph: shade
                                             warns that flattening them breaks
                                             strong encapsulation, and it is right.
                                             This jar is run with -jar, not as a
                                             module, so the descriptors describe
                                             nothing and are dropped. -->
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                        <!-- A signature covers the jar it was made
                                             for. Repackaged into a different jar it
                                             cannot verify, and a JVM that checks
                                             will refuse to load the classes. -->
                                        <!-- Shade counts the manifest as an
                                             overlapping resource even though the
                                             transformer below claims it, so the
                                             warning survives handling it. Dropping
                                             the dependencies' copies removes the
                                             overlap; the transformer still writes
                                             ours, Main-Class included. -->
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <!-- Six jars carry a MANIFEST.MF and shade keeps
                                     whichever it meets first, so Main-Class was a
                                     matter of dependency order. State it. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>fm.ticker.Ticker</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <!-- LICENSE and NOTICE are the one case where
                                     "keep one, drop the rest" is not merely untidy:
                                     the Apache licence requires the NOTICE content
                                     to travel with the redistribution. These merge
                                     rather than pick. -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
