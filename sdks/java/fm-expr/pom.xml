<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.flexemarkets</groupId>
        <artifactId>fm-sdk-parent</artifactId>
        <version>0.3.0-SNAPSHOT</version><!-- fm-version -->
    </parent>

    <artifactId>fm-expr</artifactId>

    <!--
        Its own version line, like fm-spi's, and for the same reason: this is
        arithmetic that pays people, consumed by fm-server for the live panel
        and by fm-robots for the settlement it must agree with. A change here
        is a change to what a participant is paid, and it should be a release
        someone reviews rather than a passenger on a client release.

        Set with `make set-expr-version V=x.y.z`. `make set-version` moves the
        parent reference above but leaves this alone.
    -->
    <version>0.1.0-SNAPSHOT</version><!-- expr-version -->

    <packaging>jar</packaging>

    <name>Flexemarkets Panel Expressions</name>
    <description>
        The expression language a manager writes a participant panel in, and
        the one evaluator of it. A closed grammar over a participant's private
        state, the marketplace's shared state, and their holdings: field
        references, arithmetic, comparison, a conditional, and the handful of
        vector functions the studies in fm-robots require. No loops, no
        user-defined functions, no I/O, no reach into another participant's
        state.

        One evaluator on purpose. The live panel in fm-server and the offline
        settlement in fm-robots must show and pay the same number, and two
        implementations of one formula agree by test where one agrees by
        construction. Decimal throughout: intermediate arithmetic at scale
        six, never binary floating point.

        No dependencies. Callers hand it a Scope resolving references to
        values; what a holding or a state row looks like is their business.
    </description>
    <url>https://github.com/flexemarkets/fm-sdk</url>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.7</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Self-contained POM (no <parent>) for when it is published; see parent pluginManagement. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Javadoc warnings fail this module: the Javadoc is the language's
             reference for the manager writing an expression and the developer
             evaluating one, and it is small enough to hold to that. -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <configuration>
                            <failOnWarnings>true</failOnWarnings>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
