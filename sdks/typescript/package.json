{
  "name": "@flexemarkets/fm-sdk",
  "version": "0.4.0",
  "description": "Flexemarkets TypeScript SDK",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "ticker": "tsx src/ticker.ts",
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "node --enable-source-maps --import tsx --import ./test/isolated-home.ts --test --experimental-test-coverage --test-coverage-include=src/client.ts --test-coverage-include=src/desk.ts --test-coverage-include=src/stomp.ts --test-coverage-include=src/order-utils.ts --test-coverage-include=src/orderbook.ts --test-coverage-include=src/trades.ts --test-coverage-lines=95 test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "flexemarkets",
    "trading",
    "api",
    "sdk",
    "websocket"
  ],
  "author": "Flexemarkets <support@flexemarkets.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flexemarkets/fm-sdk.git",
    "directory": "sdks/typescript"
  },
  "bugs": {
    "url": "https://github.com/flexemarkets/fm-sdk/issues"
  },
  "homepage": "https://github.com/flexemarkets/fm-sdk#readme",
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
